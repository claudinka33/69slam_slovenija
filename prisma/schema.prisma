// TEMELJ ZA NASLEDNJI KORAK (še ni aktiven — ni v package.json odvisnostih).
// Ko dodava bazo: npm i prisma @prisma/client && npx prisma migrate dev
// DATABASE_URL pride iz Vercel Postgres / Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String    @id @default(cuid())
  code       String    @unique // npr. MBYADD
  name       String
  slug       String    @unique
  collection String // core | limited
  priceCents Int
  active     Boolean   @default(true)
  variants   Variant[]
}

model Variant {
  id        String      @id @default(cuid())
  sku       String      @unique // npr. MBYADD-S
  size      String
  stock     Int         @default(0)
  product   Product     @relation(fields: [productId], references: [id])
  productId String
  moves     StockMove[]
  items     OrderItem[]
}

/// Vsaka sprememba zaloge se beleži — osnova za inventuro.
model StockMove {
  id        String   @id @default(cuid())
  variant   Variant  @relation(fields: [variantId], references: [id])
  variantId String
  delta     Int // +prejem, −prodaja, ±inventurni popravek
  reason    String // order | receiving | inventory | manual
  note      String?
  createdAt DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  number        Int         @unique @default(autoincrement()) // številka računa
  status        String      @default("new") // new | paid | shipped | done | cancelled
  payment       String // card | proforma | cod
  email         String
  name          String
  phone         String?
  address       String
  zip           String
  city          String
  country       String      @default("SI")
  lang          String      @default("sl")
  subtotalCents Int
  shippingCents Int
  codFeeCents   Int         @default(0)
  totalCents    Int
  stripeId      String?
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  variant    Variant @relation(fields: [variantId], references: [id])
  variantId  String
  qty        Int
  priceCents Int // efektivna cena (upošteva −50 % / paket −15 %)
  bundleKey  String? // kosi istega paketa imajo isti ključ
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  percent   Int
  active    Boolean   @default(true)
  oncePerCustomer Boolean @default(true)
  expiresAt DateTime?
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  lang      String   @default("sl")
  createdAt DateTime @default(now())
}
